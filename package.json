{
	"name": "obsidian-to-anki-assistant",
	"version": "1.0.0",
	"description": "Generate Anki flashcards from your notes using OpenRouter LLM API",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"anki",
		"flashcards",
		"openrouter",
		"llm"
	],
	"author": "KangHyun Lee",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"esbuild": "0.17.3",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "5.3.3"
	},
	"dependencies": {
		"@openrouter/sdk": "^0.1.27"
	}
}
